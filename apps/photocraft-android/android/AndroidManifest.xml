<?xml version="1.0" encoding="utf-8"?>
<!-- Compiled by android/build.sh with aapt2 — no Gradle, no Java sources: the system
     android.app.NativeActivity loads libphotocraft_android.so, which brings up the JVM thread
     through android-activity and calls android_main (src/lib.rs). debuggable stays on so the
     team build's logs are reachable with `adb run-as`; turn it off for any wider release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.photocomfy.app">

    <!-- For the ComfyUI transport when it lands (LAN generation); harmless otherwise. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The in-app file browser (apps/photocraft-android/src/browser.rs) reads and writes the
         shared storage directly: the system SAF pickers can't answer a NativeActivity (no
         onActivityResult), and these grants make the tree plain std::fs. READ/WRITE are
         ordinary runtime permissions (the gallery's Allow button and `pm grant` answer them);
         with the app targeting 29 they carry the *legacy* storage view on Android 11+, which
         keeps raw-path access to the whole shared storage — including RAW and .psd files — on
         versions that removed MANAGE_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <!-- Android 13+ splits media read out of READ_EXTERNAL_STORAGE; the gallery's MediaStore
         query needs it when the legacy pair is denied (a pure scoped-storage device). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <!-- The pre-scoped-storage contract the legacy view above rides on, honored for apps
         targeting 29 (the APK's targetSdkVersion): ask for it explicitly so the runtime
         permissions above mean full-path reads and writes, not the media-filtered view. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>

    <application
        android:label="PhotoComfy"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:debuggable="true"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <!-- configChanges covers rotation, fold and density changes so the activity (and the
             winit window behind it) is resized in place instead of being torn down. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="android.app.lib_name" android:value="photocraft_android"/>
        </activity>
    </application>
</manifest>
