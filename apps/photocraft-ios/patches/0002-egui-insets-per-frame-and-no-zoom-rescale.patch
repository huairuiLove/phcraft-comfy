@@ -2095,6 +2097,22 @@ impl State {
             .or_default()
             .native_pixels_per_point = Some(window.scale_factor() as f32);
 
+        // iOS: refresh the safe area every frame, converted into egui points. UIKit reports
+        // insets in UIKit points (physical / native scale) while egui consumes egui points
+        // (physical / (native * zoom)); reading them only on Resized/Focused events also froze
+        // the pre-zoom conversion (zoom 1.0 at launch), leaving the raw value in place.
+        #[cfg(target_os = "ios")]
+        {
+            let zoom = self.egui_ctx.zoom_factor().max(1e-3);
+            let SafeAreaInsets(m) = safe_area::get_safe_area_insets();
+            self.egui_input.safe_area_insets = Some(SafeAreaInsets(egui::epaint::MarginF32 {
+                left: m.left / zoom,
+                right: m.right / zoom,
+                top: m.top / zoom,
+                bottom: m.bottom / zoom,
+            }));
+        }
+
         self.egui_input.take()
     }
 
