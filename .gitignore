*~
/plan/
/target
target/
/dist
/corpus
/log
/secrets
/temp
/book/output
/craft-fonts
*.log
__pycache__/
.DS_Store
# The Android APK staging dir and its generated signing key
# (apps/photocraft-android/android/build.sh writes both; the key never leaves this machine).
apps/photocraft-android/android/build/
apps/photocraft-android/android/*.keystore
# Xcode build products for the iOS app (the GUI uses DerivedData, the CLI may write here).
apps/photocraft-ios/ios/build/
# Android build products are kept under target/android by the build script; ignore the old
# source-tree location as well so a stale checkout cannot add unsigned APK intermediates.
apps/photocraft-android/android/build/
# Xcode per-user state (schemes, UI layout) stays on the machine that made it.
xcuserdata/
*.xcuserstate
# Standalone build output dir (the iOS and Android app build scripts write here).
/out/
.zcode/
